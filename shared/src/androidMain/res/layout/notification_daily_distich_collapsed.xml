<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_card_background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginRight="8dp"
    tools:ignore="RtlHardcoded">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/daily_distich_notification_app_name"
            android:gravity="center_vertical|end"
            android:textColor="@color/notification_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|start"
            android:text="@string/daily_distich_notification_title"
            android:textColor="@color/notification_title"
            android:textSize="13sp"
            android:textStyle="bold" />

</LinearLayout>
