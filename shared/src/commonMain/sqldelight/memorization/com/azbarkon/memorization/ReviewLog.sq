-- Audit log of every review action. Records the card, grade, interval change, and timestamp.
-- Used for statistics (review history, streaks, daily review counts).
CREATE TABLE review_log (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    poem_id INTEGER NOT NULL,
    review_round INTEGER NOT NULL DEFAULT 0,
    min_total_score REAL NOT NULL DEFAULT 0.0,
    user_total_score REAL NOT NULL DEFAULT 0.0,
    card_index INTEGER NOT NULL DEFAULT 0,
    session_reviewed INTEGER NOT NULL DEFAULT 0,
    session_mistakes INTEGER NOT NULL DEFAULT 0,
    session_learned INTEGER NOT NULL DEFAULT 0
);

-- Log a new review event (normal usage).
insertReviewLog:
INSERT INTO review_log(poem_id, review_round, min_total_score,
user_total_score, card_index, session_reviewed, session_mistakes,
session_learned)
VALUES (?, ?, ?,?,?,?,?,?);

-- Log a review event with a specific id (used during import/restore).
insertReviewLogWithId:
INSERT INTO review_log(id, poem_id, review_round, min_total_score,
            user_total_score, card_index, session_reviewed, session_mistakes,
            session_learned)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Fetch all review logs ordered by id (full history export).
selectAllReviewLogs:
SELECT *
FROM review_log
ORDER BY id;

-- Wipe all review logs (used for full reset/restore).
deleteAllReviewLogs:
DELETE FROM review_log;

-- Delete all reviews belonging to a poem.
deleteReviewLogsByPoemId:
DELETE FROM review_log
WHERE poem_id = ?;

-- ToDO()
-- Get all review timestamps in descending order (used to derive unique review days for streaks).
selectReviewDayKeys:
SELECT review_round FROM review_log ORDER BY review_round DESC;

-- Total number of reviews ever performed (lifetime stat).
countReviewedVerses:
SELECT COUNT(*) FROM review_log;

lastReviewLogByPoemId:
SELECT * FROM review_log
WHERE poem_id = ?
ORDER BY id DESC LIMIT 1;

