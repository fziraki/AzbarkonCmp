-- SRS flashcard for poems.
-- Each card represents one verse of a poem.
CREATE TABLE srs_poem_card (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    poem_id INTEGER NOT NULL,
    front TEXT NOT NULL,
    back TEXT NOT NULL
);

-- Insert a new SRS card with auto-generated id.
insertCard:
INSERT INTO srs_poem_card(
    poem_id, front, back
)
VALUES (?, ?, ?);

-- Insert an SRS card with a specific id (used during import/restore).
insertCardWithId:
INSERT INTO srs_poem_card(
    id, poem_id, front, back
)
VALUES (?, ?, ?, ?);

-- Fetch every card in the database, ordered by id.
selectAllCards:
SELECT *
FROM srs_poem_card
ORDER BY id;

-- Wipe all cards.
deleteAllCards:
DELETE FROM srs_poem_card;

-- Fetch a single card by its primary key.
selectCardById:
SELECT *
FROM srs_poem_card
WHERE id = ?;

-- Fetch all cards belonging to a specific poem, ordered by id.
selectCardsByPoemId:
SELECT *
FROM srs_poem_card
WHERE poem_id = ?
ORDER BY id;

-- Fetch cards due for review for a specific poem only.
selectDueCardsByPoemId:
SELECT *
FROM srs_poem_card c
WHERE c.poem_id = ?
  AND EXISTS (
    SELECT 1 FROM srs_poem a
    WHERE a.poem_id = c.poem_id AND a.due_date <= ?
  )
ORDER BY c.id ASC;

-- Count due cards for a specific poem.
countDueCardsByPoemId:
SELECT COUNT(*)
FROM srs_poem_card c
WHERE c.poem_id = ?
  AND EXISTS (
    SELECT 1 FROM srs_poem a
    WHERE a.poem_id = c.poem_id AND a.due_date <= ?
  );

-- Delete all cards belonging to a poem.
deleteCardsByPoemId:
DELETE FROM srs_poem_card
WHERE poem_id = ?;

-- Count total cards for a poem.
countCardsByPoemId:
SELECT COUNT(*)
FROM srs_poem_card
WHERE poem_id = ?;
