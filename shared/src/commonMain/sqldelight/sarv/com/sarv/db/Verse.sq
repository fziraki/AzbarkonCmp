-- Stores the text of each verse line within a poem.
-- vorder = verse distich order, position = line within distich (0=right, 1=left).
CREATE TABLE verse (
    poem_id INTEGER NOT NULL,
    vorder INTEGER NOT NULL,
    position INTEGER NOT NULL,
    text TEXT NOT NULL
);

-- Fetch all verses of a poem in reading order (poem detail screen).
selectByPoemId:
SELECT poem_id, vorder, position, text
FROM verse
WHERE poem_id = ?
ORDER BY vorder, position;

-- Pick one random right-verse (position=0) from a poet's ghazal collection
-- matching a text prefix, used for the chat/distich-guessing game.
selectChatDistichByPoetAndPrefix:
SELECT
  v1.poem_id,
  v1.vorder,
  v1.text AS right_text
FROM verse v1
JOIN poem ON poem.id = v1.poem_id
JOIN cat ON cat.id = poem.cat_id
WHERE cat.poet_id = :poet_id
  AND cat.text = 'غزلیات'
  AND v1.position = 0
  AND length(v1.text) <= 50
  AND v1.text LIKE :prefix
ORDER BY RANDOM()
LIMIT 1;

-- Fetch the exact text of a single verse by poem, vorder, and position.
selectVerseTextByPoemVorderPosition:
SELECT text
FROM verse
WHERE poem_id = :poem_id
  AND vorder = :vorder
  AND position = :position
LIMIT 1;

-- Count total eligible distichs (distichs) for a poet, used to calculate
-- a random offset for paginated distich browsing (daily-distich feature).
-- Excludes rubaiyat and filters by poet when filter_poet is set.
selectRandomDistichCountByPoet:
SELECT COUNT(*)
FROM verse v1
JOIN verse v2
  ON v2.poem_id = v1.poem_id AND v2.vorder = v1.vorder + 1
JOIN poem ON poem.id = v1.poem_id
JOIN cat ON cat.id = poem.cat_id
WHERE v1.position = 0
  AND length(v1.text) <= 50
  AND length(v2.text) <= 50
  AND cat.text != 'رباعیات'
  AND (:filter_poet = 0 OR cat.poet_id = :poet_id);

-- Fetch a single distich at a computed offset (random-access distich browsing).
-- Joins both verse lines and includes poet name for display.
selectRandomDistichAtOffsetByPoet:
SELECT
  v1.poem_id,
  v1.vorder,
  v1.text AS right_text,
  v2.text AS left_text,
  poet.name AS poet_name
FROM verse v1
JOIN verse v2
  ON v2.poem_id = v1.poem_id AND v2.vorder = v1.vorder + 1
JOIN poem ON poem.id = v1.poem_id
JOIN cat ON cat.id = poem.cat_id
JOIN poet ON poet.id = cat.poet_id
WHERE v1.position = 0
  AND length(v1.text) <= 50
  AND length(v2.text) <= 50
  AND cat.text != 'رباعیات'
  AND (:filter_poet = 0 OR cat.poet_id = :poet_id)
ORDER BY v1.poem_id, v1.vorder
LIMIT 1 OFFSET :offset;

-- Pick a random poem id (non-rubaiyat) for the quiz/game feature.
selectRandomGamePoemId:
SELECT poem.id
FROM poem
JOIN cat ON cat.id = poem.cat_id
WHERE cat.text != 'رباعیات'
ORDER BY RANDOM()
LIMIT 1;

-- Pick a random ghazal poem id for a specific poet (fal feature).
selectRandomGhazalPoemIdByPoet:
SELECT poem.id
FROM poem
JOIN cat ON cat.id = poem.cat_id
WHERE cat.poet_id = :poet_id
  AND cat.text = 'غزلیات'
ORDER BY RANDOM()
LIMIT 1;
